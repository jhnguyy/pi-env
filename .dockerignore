# Build context hygiene: keep the image focused on source + lockfile inputs.
# Build-stage Git metadata is intentionally available so `nub run verify` can
# run checks that use `git ls-files`; the final image removes `.git`.
.git/config
.git/hooks
.git/info
.git/logs
.github/workflows/*.log
node_modules
coverage
THIRD_PARTY_LICENSES
THIRD_PARTY_SOURCES
*.tsbuildinfo

# Extension bundles are rebuilt inside the image from source.
extensions/*/dist

# Local pi state/config and credentials must never enter the image. The repository
# ships no project-local Pi resources, so these directories hold only local state.
.pi
.agents
auth.json
settings.json
models.json
permissions.json
permissions-audit.jsonl
sessions
sessions/**
*.env
*.env.*

# Host/editor/cache noise.
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.cache
.tmp

# Exported E2E evidence would invalidate the build cache.
.e2e-evidence
