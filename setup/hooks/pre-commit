#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v nub >/dev/null 2>&1; then
  echo "pre-commit: nub is required; run nix develop or install the pi-env toolchain" >&2
  exit 1
fi

echo "pre-commit: shell syntax"
bash -n setup/*.sh setup/__tests__/*.sh setup/hooks/* scripts/*.sh

# CI runs the full portfolio; keep this to fast checks that need no strict containment.
nub run verify:pre-commit
