{
  "name": "pi-env",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "workspaces": [
    ".pi/extensions/analyze",
    ".pi/extensions/general",
    ".pi/extensions/web-context",
    ".pi/extensions/dev-tools",
    ".pi/extensions/introspection",
    ".pi/extensions/notes",
    ".pi/extensions/review",
    ".pi/extensions/session-manager",
    ".pi/extensions/share",
    ".pi/extensions/subagent"
  ],
  "type": "module",
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "build": "node scripts/build-extensions.mjs",
    "clean:extensions": "node scripts/clean-extension-artifacts.mjs",
    "worktree:init": "bash scripts/init-worktree.sh",
    "subagent:service": "node .pi/extensions/subagent/dist/service.js",
    "subagent:client": "node .pi/extensions/subagent/dist/service-client.js",
    "test": "node scripts/run-supervised-node.mjs --heavyweight node_modules/vitest/vitest.mjs --run",
    "test:unit": "nub run test --project unit",
    "test:integration": "nub run test --project integration",
    "test:setup": "bash setup/__tests__/run.sh",
    "test:e2e": "nub run test --project e2e",
    "test:workflows": "nub run test:e2e",
    "test:canary": "nub run test --project real-workspace-canary",
    "test:e2e:session-manager:docker": "node scripts/dev.mjs test:docker",
    "typecheck": "node scripts/dev.mjs typecheck --noEmit --project tsconfig.typecheck.json",
    "lint:type": "node scripts/run-supervised-node.mjs --heavyweight --command scripts/tool-node-run.sh node_modules/oxlint/bin/oxlint . --type-aware --threads=1 --deny-warnings --ignore-pattern 'tests/**' --ignore-pattern '**/dist/**'",
    "check:dependencies": "depcruise . --output-type err --progress none --ignore-known .dependency-cruiser-known-violations.json",
    "format:files": "scripts/tool-node-run.sh node_modules/oxfmt/bin/oxfmt --threads=1",
    "format": "nub run format:files 'scripts/*.{js,mjs}' '.dependency-cruiser*.{cjs,json}' '.ox*.json'",
    "format:check": "nub run format --check",
    "analyze": "node .pi/extensions/analyze/dist/cli.js",
    "lint:sensors": "scripts/tool-node-run.sh node_modules/oxlint/bin/oxlint -c .oxlintrc-sensors.json --threads=1",
    "lint:changed": "nub run lint:sensors --allow no-await-in-loop --deny-warnings --no-error-on-unmatched-pattern",
    "check:duplicates:changed": "nub run analyze --diff --checks duplicates --fail-on warning",
    "check:async-risk:changed": "nub run analyze --diff --checks async-risk --fail-on error",
    "sensors": "nub run lint:sensors . && nub run analyze -- --diff --checks async-risk",
    "check:duplicates": "nub run analyze -- --checks duplicates . --fail-on error",
    "check:quality": "nub run analyze -- --all --checks duplicates,dependencies,knip --fail-on error && nub run check:patterns",
    "verify": "node scripts/dev.mjs verify",
    "verify:full": "node scripts/dev.mjs full",
    "verify:integration": "nub run format:check && nub run check:patterns && nub run check:dependencies && nub run licenses:check && nub run typecheck && nub run lint:type && nub run build && nub run test:setup && nub run test:unit && nub run test:integration && nub run verify:install && nub run test:workflows",
    "verify:install": "node scripts/verify-install.mjs",
    "verify:image-artifact": "node scripts/verify-image-artifact.mjs",
    "hydrate": "node scripts/hydrate.mjs",
    "postinstall": "nub run hydrate",
    "prebuild": "nub run check:node",
    "pretest": "nub run check:node",
    "pretest:setup": "nub run check:node",
    "pretypecheck": "nub run check:node",
    "preinstall": "nub run check:node",
    "check:patterns": "node scripts/check-patterns.js",
    "licenses:generate": "node scripts/generate-license-bundle.mjs",
    "licenses:check": "node scripts/generate-license-bundle.mjs --check",
    "security:trivy": "bash scripts/trivy-scan.sh"
  },
  "dependencies": {
    "@earendil-works/chord": "1.4.0",
    "@earendil-works/pi-durable": "1.4.0",
    "@effect/opentelemetry": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "effect": "4.0.5",
    "proper-lockfile": "4.1.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@effect/language-service": "^0.87.4",
    "@effect/tsgo": "0.56.0",
    "@effect/vitest": "4.0.5",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "8.18.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "^18.0.0",
    "esbuild": "^0.28.1",
    "knip": "^6.24.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "^1.2.18",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "dependency-cruiser": "18.0.0",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "8.6.6",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "toml": "4.2.0",
    "undici": "8.12.3",
    "vite": "8.3.3",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "nub@0.9.6",
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true
  },
  "patchedDependencies": {
    "bash-language-server@5.8.1": "patches/bash-language-server@5.8.1.patch"
  },
  "pi": {
    "extensions": [
      ".pi/extensions/analyze",
      ".pi/extensions/general",
      ".pi/extensions/web-context",
      ".pi/extensions/dev-tools",
      ".pi/extensions/introspection",
      ".pi/extensions/notes",
      ".pi/extensions/review",
      ".pi/extensions/session-manager",
      ".pi/extensions/share",
      ".pi/extensions/subagent"
    ],
    "skills": [
      ".agents/skills"
    ],
    "themes": [
      "themes"
    ]
  }
}
