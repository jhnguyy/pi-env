{
  "name": "pi-env",
  "version": "0.1.0",
  "private": true,
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "workspaces": [
    ".pi/extensions/analyze",
    ".pi/extensions/general",
    ".pi/extensions/web-context",
    ".pi/extensions/dev-tools",
    ".pi/extensions/introspection",
    ".pi/extensions/notes",
    ".pi/extensions/review",
    ".pi/extensions/session-manager",
    ".pi/extensions/share",
    ".pi/extensions/subagent"
  ],
  "type": "module",
  "scripts": {
    "check:node": "scripts/node-run.sh scripts/check-node-version.mjs",
    "build": "scripts/node-run.sh scripts/build-extensions.mjs",
    "clean:extensions": "scripts/node-run.sh scripts/clean-extension-artifacts.mjs",
    "worktree:init": "bash scripts/init-worktree.sh",
    "test": "nub run test:vitest",
    "test:vitest": "scripts/node-run.sh scripts/test.mjs all",
    "test:unit": "scripts/node-run.sh scripts/test.mjs unit",
    "test:integration": "scripts/node-run.sh scripts/test.mjs integration",
    "test:changed": "nub run test:vitest --changed",
    "test:safe": "scripts/node-run.sh scripts/run-safe-tests.mjs",
    "test:setup": "bash setup/__tests__/run.sh",
    "test:e2e": "scripts/node-run.sh scripts/test.mjs e2e",
    "test:e2e:native-tools": "scripts/node-run.sh scripts/test.mjs native-tools",
    "test:e2e:session-manager": "scripts/node-run.sh scripts/test.mjs session-manager",
    "test:e2e:session-manager:docker": "bash scripts/test-session-manager-docker.sh",
    "test:e2e:real-workspace-canary": "scripts/node-run.sh scripts/test.mjs real-workspace-canary",
    "typecheck": "bash scripts/effect-tsc.sh --noEmit --project tsconfig.typecheck.json",
    "lint:type": "scripts/node-run.sh scripts/run-supervised-node.mjs --heavyweight --command scripts/tool-node-run.sh node_modules/oxlint/bin/oxlint . --type-aware --threads=1 --deny-warnings --ignore-pattern 'tests/**' --ignore-pattern '**/dist/**'",
    "check:dependencies": "scripts/node-run.sh node_modules/dependency-cruiser/bin/dependency-cruise.mjs . --output-type err --progress none --ignore-known .dependency-cruiser-known-violations.json",
    "format": "scripts/tool-node-run.sh node_modules/oxfmt/bin/oxfmt --threads=1 'scripts/*.{js,mjs}' .dependency-cruiser.cjs .dependency-cruiser-known-violations.json .oxlintrc.json .oxlintrc-sensors.json .oxfmtrc.json",
    "format:check": "nub run format --check",
    "analyze": "scripts/node-run.sh .pi/extensions/analyze/dist/cli.js",
    "lint:sensors": "scripts/tool-node-run.sh node_modules/oxlint/bin/oxlint -c .oxlintrc-sensors.json --threads=1",
    "sensors": "nub run lint:sensors . && nub run analyze -- --diff --checks async-risk",
    "check:duplicates": "nub run analyze -- --checks duplicates . --fail-on error",
    "check:quality": "nub run analyze -- --all --checks duplicates,dependencies,knip --fail-on error && nub run check:patterns",
    "verify": "scripts/node-run.sh scripts/verify.mjs",
    "verify:safe": "scripts/node-run.sh scripts/verify-safe.mjs",
    "verify:pre-commit": "scripts/node-run.sh scripts/verify-pre-commit.mjs",
    "verify:install": "scripts/node-run.sh scripts/verify-install.mjs",
    "verify:image-artifact": "scripts/node-run.sh scripts/verify-image-artifact.mjs",
    "verify:phase": "scripts/node-run.sh scripts/verify-phase.mjs",
    "hydrate": "scripts/node-run.sh scripts/hydrate.mjs",
    "postinstall": "nub run hydrate",
    "prebuild": "nub run check:node",
    "pretest:unit": "nub run check:node",
    "pretest:integration": "nub run check:node",
    "pretest:setup": "nub run check:node",
    "pretest:e2e": "nub run check:node",
    "pretypecheck": "nub run check:node",
    "preinstall": "nub run check:node",
    "check:patterns": "scripts/node-run.sh scripts/check-patterns.js",
    "licenses:generate": "scripts/node-run.sh scripts/generate-license-bundle.mjs",
    "licenses:check": "scripts/node-run.sh scripts/generate-license-bundle.mjs --check",
    "security:trivy": "bash scripts/trivy-scan.sh",
    "quality:changed": "scripts/node-run.sh scripts/check-changed-quality.mjs"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.5",
    "@effect/platform-node": "4.0.5",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "effect": "4.0.5",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@earendil-works/pi-tui": "1.4.0",
    "@effect/language-service": "^0.87.4",
    "@effect/tsgo": "0.56.0",
    "@effect/vitest": "4.0.5",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "^18.0.0",
    "esbuild": "^0.28.1",
    "knip": "^6.24.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "^1.2.18",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "dependency-cruiser": "18.0.0",
    "minimatch": "10.2.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "8.6.6",
    "smol-toml": "1.9.1",
    "source-map-js": "1.2.2",
    "tinypool": "2.1.2",
    "toml": "4.2.0",
    "undici": "8.12.3",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "nub@0.9.6",
  "allowScripts": {
    "@google/genai": true,
    "esbuild": true
  },
  "pi": {
    "extensions": [
      ".pi/extensions/analyze",
      ".pi/extensions/general",
      ".pi/extensions/web-context",
      ".pi/extensions/dev-tools",
      ".pi/extensions/introspection",
      ".pi/extensions/notes",
      ".pi/extensions/review",
      ".pi/extensions/session-manager",
      ".pi/extensions/share",
      ".pi/extensions/subagent"
    ],
    "skills": [
      ".agents/skills"
    ],
    "themes": [
      "themes"
    ]
  }
}
