{
  "name": "pi-env",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    ".pi/extensions/analyze",
    ".pi/extensions/general",
    ".pi/extensions/credential-source",
    ".pi/extensions/web-context",
    ".pi/extensions/dev-tools",
    ".pi/extensions/introspection",
    ".pi/extensions/jit-catch",
    ".pi/extensions/linear",
    ".pi/extensions/pi-update",
    ".pi/extensions/review",
    ".pi/extensions/ptc",
    ".pi/extensions/security",
    ".pi/extensions/skill-builder",
    ".pi/extensions/subagent",
    ".pi/extensions/tool-manager"
  ],
  "pi": {
    "extensions": [
      ".pi/extensions/analyze",
      ".pi/extensions/general",
      ".pi/extensions/credential-source",
      ".pi/extensions/web-context",
      ".pi/extensions/dev-tools",
      ".pi/extensions/introspection",
      ".pi/extensions/jit-catch",
      ".pi/extensions/linear",
      ".pi/extensions/pi-update",
      ".pi/extensions/review",
      ".pi/extensions/ptc",
      ".pi/extensions/security",
      ".pi/extensions/skill-builder",
      ".pi/extensions/subagent",
      ".pi/extensions/tool-manager"
    ],
    "skills": [
      ".agents/skills"
    ],
    "themes": [
      "themes"
    ]
  },
  "scripts": {
    "check:node": "scripts/node-run.sh scripts/check-node-version.mjs",
    "build": "scripts/node-run.sh scripts/build-extensions.mjs",
    "clean:extensions": "scripts/node-run.sh scripts/clean-extension-artifacts.mjs",
    "worktree:init": "bash scripts/init-worktree.sh",
    "test": "nub run test:unit",
    "test:vitest": "scripts/node-run.sh scripts/run-supervised-node.mjs node_modules/vitest/vitest.mjs run --pool=threads",
    "test:unit": "nub run test:vitest",
    "test:changed": "nub run test:vitest --changed",
    "test:safe": "nub run test:vitest --maxWorkers=1",
    "test:setup": "bash setup/__tests__/run.sh",
    "test:e2e": "E2E=1 nub run test:vitest --maxWorkers=1",
    "test:e2e:real-workspace-canary": "E2E=1 REAL_WORKSPACE_CANARY=1 nub run test:vitest --maxWorkers=1 .pi/extensions/dev-tools/__tests__/real-workspace-canary.e2e.test.ts",
    "typecheck": "scripts/node-run.sh node_modules/typescript/bin/tsc --noEmit",
    "lint:type": "scripts/tool-node-run.sh node_modules/oxlint/bin/oxlint . --type-aware --threads=1 --deny-warnings --ignore-pattern 'tests/**' --ignore-pattern '**/dist/**'",
    "check:dependencies": "scripts/node-run.sh node_modules/dependency-cruiser/bin/dependency-cruise.mjs . --output-type err --progress none --ignore-known .dependency-cruiser-known-violations.json",
    "format": "scripts/tool-node-run.sh node_modules/oxfmt/bin/oxfmt --threads=1 scripts/check-patterns.js scripts/check-changed-quality.mjs scripts/generate-license-bundle.mjs scripts/heavyweight-lock.mjs scripts/run-supervised-node.mjs scripts/verification-phases.mjs scripts/verification-runner.mjs scripts/verify-image-artifact.mjs scripts/verify-phase.mjs scripts/verify-safe.mjs .dependency-cruiser.cjs .dependency-cruiser-known-violations.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "scripts/tool-node-run.sh node_modules/oxfmt/bin/oxfmt --threads=1 --check scripts/check-patterns.js scripts/check-changed-quality.mjs scripts/generate-license-bundle.mjs scripts/heavyweight-lock.mjs scripts/run-supervised-node.mjs scripts/verification-phases.mjs scripts/verification-runner.mjs scripts/verify-image-artifact.mjs scripts/verify-phase.mjs scripts/verify-safe.mjs .dependency-cruiser.cjs .dependency-cruiser-known-violations.json .oxlintrc.json .oxfmtrc.json",
    "analyze": "scripts/node-run.sh .pi/extensions/analyze/dist/cli.js",
    "sensors": "nub run analyze -- --diff --checks complexity,async-risk",
    "check:duplicates": "nub run analyze -- --checks duplicates . --fail-on error",
    "check:quality": "nub run analyze -- --all --checks duplicates,dependencies,knip --fail-on error && nub run check:patterns",
    "verify": "scripts/node-run.sh scripts/verify.mjs",
    "verify:safe": "scripts/node-run.sh scripts/verify-safe.mjs",
    "verify:install": "nub run build && scripts/node-run.sh scripts/verify-install.mjs",
    "verify:image-artifact": "scripts/node-run.sh scripts/verify-image-artifact.mjs",
    "verify:phase": "scripts/node-run.sh scripts/verify-phase.mjs",
    "postinstall": "sh scripts/restart-lsp-daemon.sh && scripts/node-run.sh scripts/build-extensions.mjs",
    "prepare": "scripts/node-run.sh node_modules/@effect/language-service/cli.js patch",
    "prebuild": "nub run check:node",
    "pretest:unit": "nub run check:node",
    "pretest:setup": "nub run check:node",
    "pretest:e2e": "nub run check:node",
    "pretypecheck": "nub run check:node",
    "preinstall": "nub run check:node",
    "check:patterns": "scripts/node-run.sh scripts/check-patterns.js",
    "licenses:generate": "scripts/node-run.sh scripts/generate-license-bundle.mjs",
    "licenses:check": "scripts/node-run.sh scripts/generate-license-bundle.mjs --check",
    "security:trivy": "bash scripts/trivy-scan.sh",
    "quality:changed": "scripts/node-run.sh scripts/check-changed-quality.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@effect/language-service": "^0.86.6",
    "@effect/vitest": "4.0.0-beta.97",
    "@types/node": "^24.0.0",
    "dependency-cruiser": "^18.0.0",
    "esbuild": "^0.28.1",
    "knip": "^6.24.0",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.25.0",
    "typebox": "^1.2.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "minimatch": "10.2.3",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "protobufjs": "8.6.6",
    "undici": "8.9.0"
  },
  "packageManager": "nub@0.2.10",
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.2.10",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.16.0",
      "onFail": "error"
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.0-beta.97",
    "@effect/platform-node": "4.0.0-beta.97",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-trace-node": "2.9.0",
    "effect": "4.0.0-beta.97"
  },
  "allowBuilds": {
    "@google/genai": true,
    "esbuild": true,
    "msgpackr-extract": false
  },
  "patchedDependencies": {
    "@effect/vitest@4.0.0-beta.97": "patches/@effect+vitest@4.0.0-beta.97.patch"
  }
}
