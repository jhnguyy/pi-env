@@ -0,0 +1,290 @@
+import { fauxAssistantMessage } from "@earendil-works/pi-ai";
+import { type AutocompleteProvider, Container } from "@earendil-works/pi-tui";
+import { afterEach, describe, expect, it } from "vitest";
+import type { ExtensionAPI, ExtensionCommandContext, ExtensionError } from "../../src/core/extensions/types.ts";
+import { BUILTIN_SLASH_COMMANDS } from "../../src/core/slash-commands.ts";
+import { InteractiveMode } from "../../src/modes/interactive/interactive-mode.ts";
+import { createTestExtensionsResult, createTestResourceLoader } from "../utilities.ts";
+import { createHarness, type Harness } from "./harness.ts";
+
+const harnesses: Harness[] = [];
+afterEach(() => {
+	for (const harness of harnesses.splice(0)) harness.cleanup();
+});
+
+// Exercise the real submit and autocomplete paths without starting a terminal or startup downloads.
+function createCommandMode(harness: Harness) {
+	const editor = {
+		onSubmit: undefined as ((text: string) => Promise<void>) | undefined,
+		text: "",
+		setText(text: string) {
+			this.text = text;
+		},
+		addToHistory() {},
+	};
+	const mode = Object.assign(Object.create(InteractiveMode.prototype), {
+		runtimeHost: { session: harness.session },
+		defaultEditor: editor,
+		editor,
+		chatContainer: new Container(),
+		ui: { requestRender() {} },
+		skillCommands: new Map<string, string>(),
+	}) as {
+		setupEditorSubmitHandler(): void;
+		createBaseAutocompleteProvider(): AutocompleteProvider;
+	};
+	mode.setupEditorSubmitHandler();
+	return { mode, editor };
+}
+
+describe("explicit built-in command overrides", () => {
+	it("advertises support and validates targets against the built-in catalog", async () => {
+		const result = await createTestExtensionsResult([
+			(pi) => {
+				expect(pi.supportsBuiltinCommandOverrides).toBe(true);
+				for (const { name } of BUILTIN_SLASH_COMMANDS) {
+					pi.registerCommand(name, { overrideBuiltin: true, handler: async () => {} });
+				}
+				expect(() => pi.registerCommand("typo", { overrideBuiltin: true, handler: async () => {} })).toThrow(
+					/built-in/,
+				);
+				pi.registerCommand("ordinary", { handler: async () => {} });
+			},
+		]);
+		expect(result.extensions[0].commands.size).toBe(BUILTIN_SLASH_COMMANDS.length + 1);
+	});
+
+	it.each([false, true])("gives the unique claimant the bare name regardless of load order (%s)", async (reverse) => {
+		const runs: string[] = [];
+		const factories = [
+			(pi: ExtensionAPI) =>
+				pi.registerCommand("new", {
+					handler: async () => {
+						runs.push("ordinary");
+					},
+				}),
+			(pi: ExtensionAPI) =>
+				pi.registerCommand("new", {
+					overrideBuiltin: true,
+					description: "Override new",
+					getArgumentCompletions: () => [{ value: "arg", label: "arg" }],
+					handler: async (args, ctx) => {
+						runs.push(args);
+						expect(ctx.isIdle()).toBe(true);
+					},
+				}),
+		];
+		const harness = await createHarness({ extensionFactories: reverse ? factories.reverse() : factories });
+		harnesses.push(harness);
+		expect(await harness.session.tryExecuteBuiltinCommandOverride("/new one  two")).toBe(true);
+		await harness.session.prompt("/new rpc args", { source: "rpc" });
+		expect(runs).toEqual(["one  two", "rpc args"]);
+		const commands = harness.session.extensionRunner.getRegisteredCommands();
+		expect(commands.filter((command) => command.invocationName === "new")).toHaveLength(1);
+		expect(harness.session.extensionRunner.getCommand("new")?.description).toBe("Override new");
+		expect(await harness.session.extensionRunner.getCommand("new")?.getArgumentCompletions?.("")).toEqual([
+			{ value: "arg", label: "arg" },
+		]);
+		expect(harness.eventsOfType("agent_start")).toHaveLength(0);
+	});
+
+	it("does not claim ordinary collisions, unknown commands, or non-command input", async () => {
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("new", {
+						handler: async () => {
+							throw new Error("must not run");
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		for (const text of ["/new", "/unknown", "new", "/newer"]) {
+			expect(await harness.session.tryExecuteBuiltinCommandOverride(text)).toBe(false);
+		}
+	});
+
+	it("blocks multiple claimants, reports all sources, and retains deliberate aliases", async () => {
+		const runs: string[] = [];
+		const harness = await createHarness({
+			extensionFactories: ["first", "second"].map((name) => ({
+				name,
+				factory: (pi: ExtensionAPI) =>
+					pi.registerCommand("new", {
+						overrideBuiltin: true,
+						handler: async () => {
+							runs.push(name);
+						},
+					}),
+			})),
+		});
+		harnesses.push(harness);
+		const errors: ExtensionError[] = [];
+		await harness.session.bindExtensions({ onError: (error) => errors.push(error) });
+		expect(await harness.session.tryExecuteBuiltinCommandOverride("/new")).toBe(true);
+		await harness.session.prompt("/new args");
+		expect(runs).toEqual([]);
+		expect(errors).toHaveLength(2);
+		expect(errors[0].error).toMatch(/conflict.*first.*second/i);
+		expect(harness.session.extensionRunner.getCommand("new")?.description).toMatch(/blocked/i);
+		expect(harness.session.extensionRunner.getCommandDiagnostics()).toHaveLength(1);
+		await harness.session.prompt("/new:2");
+		expect(runs).toEqual(["second"]);
+		expect(harness.eventsOfType("agent_start")).toHaveLength(0);
+		await expect(harness.session.steer("/new")).rejects.toThrow(/cannot be queued/);
+	});
+
+	it.each([0, 1, 2])("uses registry ownership for TUI submission and completion (%s claimants)", async (claimants) => {
+		const runs: string[] = [];
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) =>
+					pi.registerCommand("name", {
+						handler: async () => {
+							runs.push("ordinary");
+						},
+					}),
+				...Array.from(
+					{ length: claimants },
+					(_, index) => (pi: ExtensionAPI) =>
+						pi.registerCommand("name", {
+							overrideBuiltin: true,
+							description: "Custom name",
+							getArgumentCompletions: () => [{ value: "suggestion", label: "suggestion" }],
+							handler: async (args) => {
+								runs.push(`${index}:${args}`);
+							},
+						}),
+				),
+			],
+		});
+		harnesses.push(harness);
+		const { mode, editor } = createCommandMode(harness);
+		const errors: ExtensionError[] = [];
+		await harness.session.bindExtensions({ onError: (error) => errors.push(error) });
+		await editor.onSubmit?.("/name chosen");
+		expect(harness.session.sessionName).toBe(claimants === 0 ? "chosen" : undefined);
+		expect(runs).toEqual(claimants === 1 ? ["0:chosen"] : []);
+		expect(errors).toHaveLength(claimants === 2 ? 1 : 0);
+		const provider = mode.createBaseAutocompleteProvider();
+		const suggestions = await provider.getSuggestions(["/name"], 0, 5, { signal: new AbortController().signal });
+		const bare = suggestions?.items.filter((item) => item.value === "name");
+		expect(bare).toHaveLength(1);
+		expect(bare?.[0].description).toMatch(
+			claimants === 0 ? /Set session/ : claimants === 1 ? /Custom name/ : /blocked/,
+		);
+		if (claimants === 1) {
+			const args = await provider.getSuggestions(["/name "], 0, 6, { signal: new AbortController().signal });
+			expect(args?.items.map((item) => item.value)).toContain("suggestion");
+		}
+		expect(harness.eventsOfType("agent_start")).toHaveLength(0);
+	});
+
+	it("dispatches immediately while a run starts and while manual compaction waits", async () => {
+		const runGate = Promise.withResolvers<void>();
+		const runStarted = Promise.withResolvers<void>();
+		const compactGate = Promise.withResolvers<void>();
+		const compactStarted = Promise.withResolvers<void>();
+		const states: boolean[] = [];
+		const harness = await createHarness({
+			settings: { compaction: { enabled: false, keepRecentTokens: 1 } },
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("new", {
+						overrideBuiltin: true,
+						handler: async (_args, ctx) => {
+							states.push(ctx.isIdle());
+						},
+					});
+					pi.on("before_agent_start", async () => {
+						runStarted.resolve();
+						await runGate.promise;
+					});
+					pi.on("session_before_compact", async () => {
+						compactStarted.resolve();
+						await compactGate.promise;
+						return { cancel: true };
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		harness.setResponses([fauxAssistantMessage("response to compact")]);
+		const prompt = harness.session.prompt("message to compact");
+		await runStarted.promise;
+		try {
+			await harness.session.prompt("/new streaming");
+			expect(harness.session.pendingMessageCount).toBe(0);
+		} finally {
+			runGate.resolve();
+			await prompt;
+		}
+		const compaction = harness.session.compact().catch((error: unknown) => error);
+		await compactStarted.promise;
+		try {
+			expect(await harness.session.tryExecuteBuiltinCommandOverride("/new compacting")).toBe(true);
+			await harness.session.prompt("/new compacting via prompt");
+		} finally {
+			compactGate.resolve();
+			await compaction;
+		}
+		expect(states).toEqual([false, false, false]);
+		expect(harness.eventsOfType("agent_start")).toHaveLength(1);
+	});
+
+	it("recomputes ownership and discovery after reload", async () => {
+		let result = await createTestExtensionsResult([
+			(pi) => pi.registerCommand("new", { overrideBuiltin: true, handler: async () => {} }),
+		]);
+		const resourceLoader = {
+			...createTestResourceLoader(),
+			getExtensions: () => result,
+			reload: async () => {
+				result = await createTestExtensionsResult([]);
+			},
+		};
+		const harness = await createHarness({ resourceLoader });
+		harnesses.push(harness);
+		expect(await harness.session.tryExecuteBuiltinCommandOverride("/new")).toBe(true);
+		await harness.session.reload();
+		expect(await harness.session.tryExecuteBuiltinCommandOverride("/new")).toBe(false);
+		expect(harness.session.extensionRunner.getRegisteredCommands()).toEqual([]);
+		const { mode } = createCommandMode(harness);
+		const suggestions = await mode
+			.createBaseAutocompleteProvider()
+			.getSuggestions(["/new"], 0, 4, { signal: new AbortController().signal });
+		expect(suggestions?.items.find((item) => item.value === "new")?.description).toBe("Start a new session");
+	});
+
+	it("consumes errors and refusals and preserves stale command-context guards", async () => {
+		let captured: ExtensionCommandContext | undefined;
+		const harness = await createHarness({
+			extensionFactories: [
+				(pi) => {
+					pi.registerCommand("new", {
+						overrideBuiltin: true,
+						handler: async (args, ctx) => {
+							captured = ctx;
+							if (args === "fail") throw new Error("refused");
+							if (!(await ctx.ui.confirm("Continue?", ""))) return;
+							throw new Error("unexpected confirmation");
+						},
+					});
+				},
+			],
+		});
+		harnesses.push(harness);
+		const errors: ExtensionError[] = [];
