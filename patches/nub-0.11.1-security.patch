 # Pure-Rust zstd DECODER for inflating the embedded runtime blob on first run
diff --git a/vendor/aube/Cargo.toml b/vendor/aube/Cargo.toml
index 121bcbe..5cc4699 100644
--- a/vendor/aube/Cargo.toml
+++ b/vendor/aube/Cargo.toml
@@ -192,7 +192,7 @@ zstd = { version = "0.13", default-features = false }
 # zip-of-JSONs and the dependency-free std crate ecosystem has no
 # alternative. `deflate` is the only OSV-used compression method, so
 # defeature everything else to keep the build slim.
-zip = { version = "8", default-features = false, features = ["deflate"] }
+zip = { version = "9.0.5", default-features = false, features = ["deflate"] }

 # Semver
 node-semver = "2"
